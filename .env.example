# Alpaca Paper Trading API — get keys at https://app.alpaca.markets
# PAPER trading keys only — never use live keys here
#
# These are SERVER-ONLY variables (no VITE_ prefix).
# They are used by the /api/ serverless functions and never sent to the browser.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_DATA_URL=https://data.alpaca.markets/v2
